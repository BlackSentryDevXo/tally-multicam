{
  "expo": {
    "name": "Tally Cam",
    "slug": "tally-cam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.tally.cam",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Tally Cam records video for your production.",
        "NSMicrophoneUsageDescription": "Tally Cam records audio with the video.",
        "NSPhotoLibraryAddUsageDescription": "Tally Cam saves a backup copy of every clip to Photos.",
        "NSLocalNetworkUsageDescription": "Tally Cam connects to Tally Hub on your computer over Wi-Fi.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "UIRequiresFullScreen": true
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "com.tally.cam",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0b0b0c",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "versionCode": 1
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Tally Cam saves a backup copy of every clip to Photos.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0b0b0c",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ]
    ],
    "scheme": "tally",
    "backgroundColor": "#000000"
  }
}
