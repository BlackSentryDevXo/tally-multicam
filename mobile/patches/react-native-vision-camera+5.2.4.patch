+package com.margelo.nitro.camera.hybrids
+
+import android.annotation.SuppressLint
+import android.hardware.camera2.CameraCaptureSession
+import android.hardware.camera2.CameraCharacteristics
+import android.hardware.camera2.CameraMetadata
+import android.hardware.camera2.CaptureRequest
+import android.hardware.camera2.CaptureResult
+import android.hardware.camera2.TotalCaptureResult
+import android.hardware.camera2.params.ColorSpaceTransform
+import android.hardware.camera2.params.RggbChannelVector
+import android.util.Log
+import android.util.Range
+import androidx.camera.camera2.interop.applyCamera2InteropAsync
+import androidx.camera.core.Camera
+import com.google.common.util.concurrent.ListenableFuture
+import com.margelo.nitro.camera.extensions.cameraCharacteristicsOrNull
+import java.util.concurrent.Executor
+import kotlin.math.max
+import kotlin.math.min
+import kotlin.math.sqrt
+
+/**
+ * [Tally patch] Manual focus / exposure / white-balance for Android via CameraX Camera2 interop.
+ *
+ * CameraX only exposes continuous 3A, so this class keeps the requested manual state and
+ * re-applies the full set of Camera2 capture-request options every time something changes
+ * (clear-all + set), which is deterministic regardless of how CameraX merges interop configs.
+ * A repeating capture callback reads the live ISO / shutter / focus distance / AWB gains so
+ * `lockCurrent*()` can freeze the values the camera is using right now.
+ */
+@SuppressLint("RestrictedApi", "UnsafeOptInUsageError")
+internal class ManualCamera2Controls(
+  private val camera: Camera,
+) {
+  private val characteristics: CameraCharacteristics? = camera.cameraInfo.cameraCharacteristicsOrNull
+  private val capabilities: IntArray =
+    characteristics?.get(CameraCharacteristics.REQUEST_AVAILABLE_CAPABILITIES) ?: intArrayOf()
+
+  val supportsManualSensor = CameraMetadata.REQUEST_AVAILABLE_CAPABILITIES_MANUAL_SENSOR in capabilities
+  val supportsManualPostProcessing =
+    CameraMetadata.REQUEST_AVAILABLE_CAPABILITIES_MANUAL_POST_PROCESSING in capabilities
+
+  /** Diopters (1/m). 0 means fixed-focus. */
+  val minFocusDistance: Float = characteristics?.get(CameraCharacteristics.LENS_INFO_MINIMUM_FOCUS_DISTANCE) ?: 0f
+  val supportsFocusLocking = supportsManualSensor && minFocusDistance > 0f
+  val supportsExposureLocking = supportsManualSensor
+  val supportsWhiteBalanceLocking = supportsManualPostProcessing
+  private val aeLockAvailable = characteristics?.get(CameraCharacteristics.CONTROL_AE_LOCK_AVAILABLE) ?: false
+  private val awbLockAvailable = characteristics?.get(CameraCharacteristics.CONTROL_AWB_LOCK_AVAILABLE) ?: false
+
+  val isoRange: Range<Int>? = characteristics?.get(CameraCharacteristics.SENSOR_INFO_SENSITIVITY_RANGE)
+  val exposureRangeNs: Range<Long>? = characteristics?.get(CameraCharacteristics.SENSOR_INFO_EXPOSURE_TIME_RANGE)
+
+  // ---- requested state ----
+  private var focusDistance: Float? = null // manual lens distance in diopters
+  private var focusHold = false // AF_MODE_AUTO without trigger (fallback lock)
+  private var manualExposure: Pair<Long, Int>? = null // (exposure ns, ISO)
+  private var aeLock = false
+  private var manualGains: RggbChannelVector? = null
+  private var manualTransform: ColorSpaceTransform? = null
+  private var awbLock = false
+
+  // ---- live values from the capture results ----
+  @Volatile var resultIso: Int? = null
+    private set
+
+  @Volatile var resultExposureNs: Long? = null
+    private set
+
+  @Volatile var resultFocusDistance: Float? = null
+    private set
+
+  @Volatile var resultGains: RggbChannelVector? = null
+    private set
+
+  @Volatile private var autoTransform: ColorSpaceTransform? = null
+
+  /** Frame duration chosen by auto-exposure (keeps the target fps when we take over AE). */
+  @Volatile private var autoFrameDurationNs: Long? = null
+
+  private val directExecutor = Executor { it.run() }
+  private val captureCallback =
+    object : CameraCaptureSession.CaptureCallback() {
+      override fun onCaptureCompleted(
+        session: CameraCaptureSession,
+        request: CaptureRequest,
+        result: TotalCaptureResult,
+      ) {
+        result.get(CaptureResult.SENSOR_SENSITIVITY)?.let { resultIso = it }
+        result.get(CaptureResult.SENSOR_EXPOSURE_TIME)?.let { resultExposureNs = it }
+        result.get(CaptureResult.LENS_FOCUS_DISTANCE)?.let { resultFocusDistance = it }
+        result.get(CaptureResult.COLOR_CORRECTION_GAINS)?.let { resultGains = it }
+        if (manualGains == null) result.get(CaptureResult.COLOR_CORRECTION_TRANSFORM)?.let { autoTransform = it }
+        if (manualExposure == null) result.get(CaptureResult.SENSOR_FRAME_DURATION)?.let { autoFrameDurationNs = it }
+      }
+    }
+
+  val isFocusLocked get() = focusDistance != null || focusHold
+  val isExposureLocked get() = manualExposure != null || aeLock
+  val isWhiteBalanceLocked get() = manualGains != null || awbLock
+
+  /** 0.0 (closest) ... 1.0 (infinity), iOS semantics. */
+  val lensPosition: Double
+    get() {
+      if (!supportsFocusLocking) return 0.0
+      val d = focusDistance ?: resultFocusDistance ?: return 0.0
+      return (1.0 - d / minFocusDistance).coerceIn(0.0, 1.0)
+    }
+
+  val minExposureDurationSec: Double
+    get() = if (supportsExposureLocking) (exposureRangeNs?.lower ?: 0L) / 1e9 else 0.0
+
+  /** Capped at the current frame interval so manual shutter never drops the frame rate. */
+  val maxExposureDurationSec: Double
+    get() {
+      if (!supportsExposureLocking) return 0.0
+      val sensorMax = exposureRangeNs?.upper ?: return 0.0
+      val frame = autoFrameDurationNs
+      return (if (frame != null && frame > 0) min(sensorMax, frame) else sensorMax) / 1e9
+    }
+
+  val exposureDurationSec: Double
+    get() = (manualExposure?.first ?: resultExposureNs ?: 0L) / 1e9
+
+  val iso: Double
+    get() = (manualExposure?.second ?: resultIso ?: 0).toDouble()
+
+  // ---------------- setters ----------------
+
+  fun setFocusLocked(lensPosition: Double): ListenableFuture<Void> {
+    if (!supportsFocusLocking) {
+      throw Error("This camera does not support manual focus (needs Camera2 MANUAL_SENSOR and a focusable lens).")
+    }
+    if (lensPosition < 0.0 || lensPosition > 1.0) {
+      throw Error("`lensPosition` must be within 0.0 ... 1.0, received $lensPosition.")
+    }
+    focusDistance = ((1.0 - lensPosition) * minFocusDistance).toFloat()
+    focusHold = false
+    return apply()
+  }
+
+  fun lockCurrentFocus(): ListenableFuture<Void> {
+    val current = resultFocusDistance
+    if (supportsFocusLocking && current != null) {
+      focusDistance = current
+    } else if (minFocusDistance > 0f) {
+      focusHold = true // AF_MODE_AUTO holds the lens where it is until re-triggered
+    } else {
+      throw Error("This camera has a fixed-focus lens, focus cannot be locked.")
+    }
+    return apply()
+  }
+
+  fun setExposureLocked(
+    durationSec: Double,
+    iso: Double,
+  ): ListenableFuture<Void> {
+    if (!supportsExposureLocking) {
+      throw Error("This camera does not support manual exposure (needs Camera2 MANUAL_SENSOR).")
+    }
+    val minD = minExposureDurationSec
+    val maxD = maxExposureDurationSec
+    if (durationSec < minD || durationSec > maxD) {
+      throw Error("`duration` must be within $minD ... $maxD seconds, received $durationSec.")
+    }
+    val range = isoRange ?: throw Error("This camera does not report an ISO range.")
+    if (iso < range.lower || iso > range.upper) {
+      throw Error("`iso` must be within ${range.lower} ... ${range.upper}, received $iso.")
+    }
+    manualExposure = Pair((durationSec * 1e9).toLong(), iso.toInt())
+    aeLock = false
+    return apply()
+  }
+
+  fun lockCurrentExposure(): ListenableFuture<Void> {
+    val ns = resultExposureNs
+    val currentIso = resultIso
+    if (supportsExposureLocking && ns != null && currentIso != null) {
+      manualExposure = Pair(ns, currentIso)
+    } else if (aeLockAvailable) {
+      aeLock = true
+    } else {
+      throw Error("This camera does not support locking exposure.")
+    }
+    return apply()
+  }
+
+  fun setWhiteBalanceLocked(
+    red: Double,
+    green: Double,
+    blue: Double,
+  ): ListenableFuture<Void> {
+    if (!supportsWhiteBalanceLocking) {
+      throw Error("This camera does not support manual white balance (needs Camera2 MANUAL_POST_PROCESSING).")
+    }
+    for ((name, g) in listOf("redGain" to red, "greenGain" to green, "blueGain" to blue)) {
+      if (g < 1.0 || g > MAX_WB_GAIN) throw Error("`$name` must be within 1.0 ... $MAX_WB_GAIN, received $g.")
+    }
+    manualGains = RggbChannelVector(red.toFloat(), green.toFloat(), green.toFloat(), blue.toFloat())
+    manualTransform = autoTransform
+    awbLock = false
+    return apply()
+  }
+
+  fun lockCurrentWhiteBalance(): ListenableFuture<Void> {
+    val gains = resultGains
+    if (supportsWhiteBalanceLocking && gains != null) {
+      manualGains = gains
+      manualTransform = autoTransform
+    } else if (awbLockAvailable) {
+      awbLock = true
+    } else {
+      throw Error("This camera does not support locking white balance.")
+    }
+    return apply()
+  }
+
+  fun resetAll(): ListenableFuture<Void> {
+    focusDistance = null
+    focusHold = false
+    manualExposure = null
+    aeLock = false
+    manualGains = null
+    manualTransform = null
+    awbLock = false
+    return apply()
+  }
+
+  /** Installs the capture callback so live values are available before any lock. */
+  fun start() {
+    try {
+      apply()
+    } catch (e: Throwable) {
