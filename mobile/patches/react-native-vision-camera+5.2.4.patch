+
+/**
+ * [Tally patch] Color temperature + tint to Camera2 white-balance gains.
+ *
+ * Preferred path (DNG math, the same approach Adobe's DNG SDK uses):
+ *  1. Planckian locus xy for the temperature (Kim et al. cubic approximation, 1667-25000 K).
+ *  2. Tint shifts the point perpendicular to the locus in CIE 1960 uv, 1 tint unit = 1/3000 uv
+ *     (Adobe convention; positive = magenta correction).
+ *  3. Camera-neutral = (CALIBRATION_TRANSFORM * COLOR_TRANSFORM) * XYZ, with the matrix
+ *     interpolated between the sensor's two reference illuminants by inverse temperature.
+ *  4. Gains = neutral.green / neutral.channel (green = 1), normalised so no gain is below 1.
+ *
+ * Fallback when the HAL has no color calibration (non-RAW devices): linear sRGB of the
+ * illuminant scaled by typical CMOS daylight gains (R 2.0, B 1.6 at D65). This is only an
+ * approximation; colours will be close but not reference-accurate on such devices.
+ */
+internal object WhiteBalanceMath {
+  fun gainsFor(
+    c: CameraCharacteristics?,
+    temperature: Double,
+    tint: Double,
+    maxGain: Double,
+  ): DoubleArray {
+    val t = temperature.coerceIn(1700.0, 25000.0)
+    val xyz = xyzFor(t, tint)
+    val neutral = cameraNeutral(c, t, xyz) ?: fallbackNeutral(xyz)
+    var r = neutral[1] / neutral[0]
+    var g = 1.0
+    var b = neutral[1] / neutral[2]
+    val lowest = min(r, min(g, b))
+    if (lowest < 1.0) {
+      r /= lowest
+      g /= lowest
+      b /= lowest
+    }
+    return doubleArrayOf(r.coerceIn(1.0, maxGain), g.coerceIn(1.0, maxGain), b.coerceIn(1.0, maxGain))
+  }
+
+  /** Planckian xy (Kim et al. 2002). */
+  fun planckXy(t: Double): DoubleArray {
+    val t2 = t * t
+    val t3 = t2 * t
+    val x =
+      if (t <= 4000) {
+        -0.2661239e9 / t3 - 0.2343589e6 / t2 + 0.8776956e3 / t + 0.179910
+      } else {
+        -3.0258469e9 / t3 + 2.1070379e6 / t2 + 0.2226347e3 / t + 0.240390
+      }
+    val x2 = x * x
+    val x3 = x2 * x
+    val y =
+      when {
+        t <= 2222 -> -1.1063814 * x3 - 1.34811020 * x2 + 2.18555832 * x - 0.20219683
+        t <= 4000 -> -0.9549476 * x3 - 1.37418593 * x2 + 2.09137015 * x - 0.16748867
+        else -> 3.0817580 * x3 - 5.87338670 * x2 + 3.75112997 * x - 0.37001483
+      }
+    return doubleArrayOf(x, y)
+  }
+
+  private fun xyToUv(xy: DoubleArray): DoubleArray {
+    val d = -2 * xy[0] + 12 * xy[1] + 3
+    return doubleArrayOf(4 * xy[0] / d, 6 * xy[1] / d)
+  }
+
+  private fun uvToXy(uv: DoubleArray): DoubleArray {
+    val d = 2 * uv[0] - 8 * uv[1] + 4
+    return doubleArrayOf(3 * uv[0] / d, 2 * uv[1] / d)
+  }
+
+  /** White point XYZ (Y = 1) for a temperature and tint. */
+  fun xyzFor(
+    t: Double,
+    tint: Double,
+  ): DoubleArray {
+    val uv = xyToUv(planckXy(t))
+    if (tint != 0.0) {
+      val uv2 = xyToUv(planckXy(min(t + 10, 25000.0)))
+      val du = uv2[0] - uv[0]
+      val dv = uv2[1] - uv[1]
+      val len = sqrt(du * du + dv * dv)
+      if (len > 0) {
+        // Unit normal pointing toward higher v (green side of the locus).
+        var nu = -dv / len
+        var nv = du / len
+        if (nv < 0) {
+          nu = -nu
+          nv = -nv
+        }
+        // Positive tint (magenta correction) assumes a greener illuminant.
+        uv[0] += nu * tint / 3000.0
+        uv[1] += nv * tint / 3000.0
+      }
+    }
+    val xy = uvToXy(uv)
+    return doubleArrayOf(xy[0] / xy[1], 1.0, (1 - xy[0] - xy[1]) / xy[1])
+  }
+
+  private fun illuminantCct(code: Int?): Double? =
+    when (code) {
+      CameraMetadata.SENSOR_REFERENCE_ILLUMINANT1_DAYLIGHT -> 5500.0
+      CameraMetadata.SENSOR_REFERENCE_ILLUMINANT1_FLUORESCENT -> 4150.0
+      CameraMetadata.SENSOR_REFERENCE_ILLUMINANT1_TUNGSTEN -> 2850.0
+      CameraMetadata.SENSOR_REFERENCE_ILLUMINANT1_FLASH -> 5500.0
+      CameraMetadata.SENSOR_REFERENCE_ILLUMINANT1_FINE_WEATHER -> 5500.0
+      CameraMetadata.SENSOR_REFERENCE_ILLUMINANT1_CLOUDY_WEATHER -> 6500.0
+      CameraMetadata.SENSOR_REFERENCE_ILLUMINANT1_SHADE -> 7500.0
+      CameraMetadata.SENSOR_REFERENCE_ILLUMINANT1_DAYLIGHT_FLUORESCENT -> 6430.0
+      CameraMetadata.SENSOR_REFERENCE_ILLUMINANT1_DAY_WHITE_FLUORESCENT -> 5000.0
+      CameraMetadata.SENSOR_REFERENCE_ILLUMINANT1_COOL_WHITE_FLUORESCENT -> 4150.0
+      CameraMetadata.SENSOR_REFERENCE_ILLUMINANT1_WHITE_FLUORESCENT -> 3525.0
+      CameraMetadata.SENSOR_REFERENCE_ILLUMINANT1_STANDARD_A -> 2856.0
+      CameraMetadata.SENSOR_REFERENCE_ILLUMINANT1_STANDARD_B -> 4874.0
+      CameraMetadata.SENSOR_REFERENCE_ILLUMINANT1_STANDARD_C -> 6774.0
+      CameraMetadata.SENSOR_REFERENCE_ILLUMINANT1_D55 -> 5503.0
+      CameraMetadata.SENSOR_REFERENCE_ILLUMINANT1_D65 -> 6504.0
+      CameraMetadata.SENSOR_REFERENCE_ILLUMINANT1_D75 -> 7504.0
+      CameraMetadata.SENSOR_REFERENCE_ILLUMINANT1_D50 -> 5003.0
+      CameraMetadata.SENSOR_REFERENCE_ILLUMINANT1_ISO_STUDIO_TUNGSTEN -> 3200.0
+      else -> null
+    }
+
+  /** Row-major 3x3 from a Camera2 transform. */
+  private fun matrix(m: ColorSpaceTransform): Array<DoubleArray> =
+    Array(3) { row -> DoubleArray(3) { col -> m.getElement(col, row).toDouble() } }
+
+  private fun mul(
+    a: Array<DoubleArray>,
+    b: Array<DoubleArray>,
+  ): Array<DoubleArray> = Array(3) { r -> DoubleArray(3) { c -> (0 until 3).sumOf { k -> a[r][k] * b[k][c] } } }
+
+  private fun mulVec(
+    m: Array<DoubleArray>,
+    v: DoubleArray,
+  ): DoubleArray = DoubleArray(3) { r -> m[r][0] * v[0] + m[r][1] * v[1] + m[r][2] * v[2] }
+
+  private fun cameraNeutral(
+    c: CameraCharacteristics?,
+    t: Double,
+    xyz: DoubleArray,
+  ): DoubleArray? {
+    if (c == null) return null
+    val cm1 = c.get(CameraCharacteristics.SENSOR_COLOR_TRANSFORM1) ?: return null
+    val cct1 = illuminantCct(c.get(CameraCharacteristics.SENSOR_REFERENCE_ILLUMINANT1)) ?: return null
+    val cal1 = c.get(CameraCharacteristics.SENSOR_CALIBRATION_TRANSFORM1)
+    val m1 = if (cal1 != null) mul(matrix(cal1), matrix(cm1)) else matrix(cm1)
+
+    val cm2 = c.get(CameraCharacteristics.SENSOR_COLOR_TRANSFORM2)
+    val cct2 = illuminantCct(c.get(CameraCharacteristics.SENSOR_REFERENCE_ILLUMINANT2)?.toInt())
+    val m =
+      if (cm2 != null && cct2 != null && cct2 != cct1) {
+        val cal2 = c.get(CameraCharacteristics.SENSOR_CALIBRATION_TRANSFORM2)
+        val m2 = if (cal2 != null) mul(matrix(cal2), matrix(cm2)) else matrix(cm2)
+        // Interpolate by inverse temperature between the two calibration illuminants.
+        val (lo, hi, mLo, mHi) =
+          if (cct1 < cct2) Quad(cct1, cct2, m1, m2) else Quad(cct2, cct1, m2, m1)
+        val w = ((1 / t - 1 / hi) / (1 / lo - 1 / hi)).coerceIn(0.0, 1.0)
+        Array(3) { r -> DoubleArray(3) { col -> w * mLo[r][col] + (1 - w) * mHi[r][col] } }
+      } else {
+        m1
+      }
+    val n = mulVec(m, xyz)
+    return if (n.all { it > 1e-6 }) n else null
+  }
+
+  private data class Quad(
+    val lo: Double,
+    val hi: Double,
+    val mLo: Array<DoubleArray>,
+    val mHi: Array<DoubleArray>,
+  )
+
+  private fun fallbackNeutral(xyz: DoubleArray): DoubleArray {
+    // XYZ -> linear sRGB (D65)
+    val r = 3.2406 * xyz[0] - 1.5372 * xyz[1] - 0.4986 * xyz[2]
+    val g = -0.9689 * xyz[0] + 1.8758 * xyz[1] + 0.0415 * xyz[2]
+    val b = 0.0557 * xyz[0] - 0.2040 * xyz[1] + 1.0570 * xyz[2]
+    val d65 = xyzFor(6504.0, 0.0)
+    val r65 = 3.2406 * d65[0] - 1.5372 * d65[1] - 0.4986 * d65[2]
+    val g65 = -0.9689 * d65[0] + 1.8758 * d65[1] + 0.0415 * d65[2]
+    val b65 = 0.0557 * d65[0] - 0.2040 * d65[1] + 1.0570 * d65[2]
+    // Typical CMOS sensor needs ~2.0x red and ~1.6x blue at D65: neutral = sRGB response / those gains.
+    return doubleArrayOf(
+      max(r / r65, 1e-3) / 2.0,
+      max(g / g65, 1e-3),
+      max(b / b65, 1e-3) / 1.6,
+    )
+  }
+}
