{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["camera", "tallystream"],
  "ios": {
    "iosModuleName": "TallyStream"
  },
  "android": {
    "androidNamespace": ["camera", "tallystream"],
    "androidCxxLibName": "TallyStream"
  },
  "autolinking": {
    "LiveStreamFactory": {
      "ios": { "language": "swift", "implementationClassName": "HybridLiveStreamFactory" },
      "android": { "language": "kotlin", "implementationClassName": "HybridLiveStreamFactory" }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
